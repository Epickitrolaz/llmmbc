+void rpc_server::open_model_file(const char * model_file) {
+    if (model_file == nullptr || *model_file == '\0') {
+        return;
+    }
+#if defined(_WIN32)
+    model_fd = _open(model_file, _O_RDONLY | _O_BINARY);
+#else
+    model_fd = ::open(model_file, O_RDONLY);
+#endif
+    if (model_fd < 0) {
+        LOG_ERROR("[%s] failed to open model file '%s'\n", __func__, model_file);
+        return;
+    }
+    std::error_code ec;
+    const auto size = fs::file_size(model_file, ec);
+    if (ec) {
+        LOG_ERROR("[%s] failed to stat model file '%s': %s\n", __func__, model_file, ec.message().c_str());
+#if defined(_WIN32)
+        _close(model_fd);
+#else
+        ::close(model_fd);
+#endif
+        model_fd = -1;
+        return;
+    }
+    model_size = (size_t) size;
+#if !defined(_WIN32)
+    if (lazy_weights && model_size > 0) {
+        // MAP_PRIVATE: the file (opened O_RDONLY) is never modified; stray writes are COW.
+        void * map = mmap(nullptr, model_size, PROT_READ | PROT_WRITE, MAP_PRIVATE, model_fd, 0);
+        if (map == MAP_FAILED) {
+            LOG_WARN("[%s] mmap of '%s' failed (%s); weights will be read from the file instead\n",
+                     __func__, model_file, std::strerror(errno));
+        } else {
+            model_map = (uint8_t *) map;
+        }
+    }
+#endif
+    LOG_INFO("[%s] model file: %s (%s), lazy weights: %s\n", __func__, model_file,
+             rpc_log_format_size(model_size).c_str(),
+             model_map ? "on (GGUF mapped, buffers use MAP_NORESERVE)"
+                       : (lazy_weights ? "requested but unavailable, reading from file" : "off"));
+}
+
+bool rpc_server::read_model_file(void * dst, size_t size, uint64_t offset) const {
+    if (model_fd < 0) {
+        return false;
+    }
+    if (offset > model_size || size > model_size - offset) {
+        LOG_ERROR("[%s] region (offset=%" PRIu64 ", size=%zu) out of model file bounds [0, %zu)\n",
+                  __func__, offset, size, model_size);
+        return false;
+    }
+    constexpr size_t chunk_size = 16 * 1024 * 1024;
+    for (size_t done = 0; done < size; ) {
+        const size_t n = std::min(size - done, chunk_size);
+        uint8_t * out = (uint8_t *) dst + done;
+#if defined(_WIN32)
+        if (_lseeki64(model_fd, (long long) (offset + done), SEEK_SET) < 0) {
+            return false;
+        }
+        const int got = _read(model_fd, out, (unsigned) n);
+        if (got < 0 || (size_t) got != n) {
+            return false;
+        }
+#else
+        ssize_t got;
+        do {
+            got = pread(model_fd, out, n, (off_t) (offset + done));
+        } while (got < 0 && errno == EINTR);
+        if (got < 0 || (size_t) got != n) {
+            return false;
+        }
+#endif
+        done += n;
+    }
+    return true;
+}
+
+uint64_t rpc_server::remap_lazy_data(uint64_t remote) const {
+    if (lazy_regions.empty()) {
+        return remote;
+    }
+    auto it = lazy_regions.upper_bound(remote);
+    if (it == lazy_regions.begin()) {
+        return remote;
+    }
+    --it;
+    if (remote - it->second.remote < it->second.size) {
+        return (uint64_t) (uintptr_t) (it->second.mapped + (remote - it->second.remote));
+    }
+    return remote;
+}
