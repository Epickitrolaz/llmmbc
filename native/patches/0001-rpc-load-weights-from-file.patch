+bool rpc_server::set_tensor_from_file(const rpc_msg_set_tensor_from_file_req & request, rpc_msg_set_tensor_from_file_rsp & response) {
+    sync_all_backends();
+    // `response.result = 0` is the fallback signal: the client then sends the bytes with
+    // SET_TENSOR as it would to an old server. Recoverable problems (missing file, bounds
+    // mismatch, short read) therefore keep the connection alive instead of aborting it.
+    response.result = 0;
+    if (model_fd < 0) {
+        LOG_ERROR("[%s] no --model-file on this server, asking the client to send bytes\n", __func__);
+        return true;
+    }
+
+    struct ggml_init_params params {
+        /*.mem_size   =*/ ggml_tensor_overhead(),
+        /*.mem_buffer =*/ NULL,
+        /*.no_alloc   =*/ true,
+    };
+    ggml_context_ptr ctx_ptr { ggml_init(params) };
+    GGML_ASSERT(ctx_ptr != nullptr);
+    ggml_context * ctx = ctx_ptr.get();
+    ggml_tensor * tensor = deserialize_tensor(ctx, &request.tensor);
+    if (tensor == nullptr || tensor->buffer == nullptr) {
+        LOG_ERROR("[%s] error deserializing tensor, asking the client to send bytes\n", __func__);
+        return true;
+    }
+    const size_t p0 = (size_t) ggml_backend_buffer_get_base(tensor->buffer);
+    const size_t p1 = p0 + ggml_backend_buffer_get_size(tensor->buffer);
+    if (request.tensor.data < p0 ||
+        request.tensor.data + request.offset >= p1 ||
+        request.size > p1 - request.tensor.data - request.offset) {
+        LOG_ERROR("[%s] tensor data region (data=0x%" PRIx64 ", offset=%" PRIu64 ", size=%" PRIu64 ") "
+                  "out of buffer bounds [0x%zx, 0x%zx), asking the client to send bytes\n",
+                  __func__, request.tensor.data, request.offset, request.size, p0, p1);
+        return true;
+    }
+    const uint64_t tensor_size = (uint64_t) ggml_nbytes(tensor);
+    if (request.offset > tensor_size || request.size > tensor_size - request.offset) {
+        LOG_ERROR("[%s] region (offset=%" PRIu64 ", size=%" PRIu64 ") out of tensor bounds [0, %" PRIu64
+                  "), asking the client to send bytes\n",
+                  __func__, request.offset, request.size, tensor_size);
+        return true;
