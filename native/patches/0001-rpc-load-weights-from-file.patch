+// One machine-readable line every 16 MiB keeps the log bounded during generation; the final
+// line (logged on disconnect) always carries the exact totals.
+void rpc_server::log_transfer(const char * op, const ggml_tensor * tensor, size_t size) {
+    GGML_UNUSED(size);
+    const uint64_t total = from_file_bytes + socket_bytes;
+    if (total < next_log_bytes) {
+        return;
+    }
+    next_log_bytes = (total / (16ull << 20) + 1) * (16ull << 20);
+    LOG_INFO("[%s] %s: %s, totals: from_file_bytes=%" PRIu64 " from_file_tensors=%" PRIu64 " socket_bytes=%" PRIu64 "\n",
+             __func__, op, tensor ? tensor->name : "-", from_file_bytes, from_file_tensors, socket_bytes);
+}
