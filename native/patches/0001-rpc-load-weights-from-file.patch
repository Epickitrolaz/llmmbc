+    ggml_backend_dev_t dev = ggml_backend_buft_get_device(buft);
+    ggml_backend_reg_t reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
+    if (reg == nullptr) {
+        return false;
+    }
+    auto fn = (ggml_backend_rpc_set_tensor_from_file_t)
+        ggml_backend_reg_get_proc_address(reg, "ggml_backend_rpc_set_tensor_from_file");
+    return fn != nullptr && fn(tensor, offset, file_offset, size);
