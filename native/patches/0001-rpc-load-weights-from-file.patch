+// over the socket. Returns false for local buffers and for servers without --model-file (the
+// HELLO flag is checked client-side, so this costs no round trip); the caller then sends bytes.
+static bool llama_rpc_set_tensor_from_file(ggml_tensor * tensor, size_t offset, size_t file_offset, size_t size) {
+    if (tensor->buffer == nullptr) {
