+GGML_BACKEND_API bool ggml_backend_rpc_set_tensor_from_file(ggml_tensor * tensor, size_t offset, size_t file_offset, size_t size) {
+    if (tensor == nullptr || tensor->buffer == nullptr || !ggml_backend_buffer_is_rpc(tensor->buffer)) {
+        return false;
+    }
+    ggml_backend_rpc_buffer_context * ctx = (ggml_backend_rpc_buffer_context *)tensor->buffer->context;
+    if (!ctx->dispatcher->get_set_tensor_from_file()) {
+        // unpatched server or one started without --model-file: send the bytes instead
+        return false;
+    }
+    auto request = std::make_shared<rpc_msg_set_tensor_from_file_req>();
+    request->tensor      = serialize_tensor(tensor, ctx->dispatcher.get());
+    request->offset      = offset;
+    request->file_offset = file_offset;
+    request->size        = size;
+    LOG_DBG2("[%s] tensor: %s, offset: %zu, file_offset: %zu, size: %s\n", __func__,
+             rpc_log_format_tensor(tensor).c_str(), offset, file_offset, rpc_log_format_size(size).c_str());
+    rpc_msg_set_tensor_from_file_rsp response = {};
+    ctx->dispatcher->send(RPC_CMD_SET_TENSOR_FROM_FILE, request, sizeof(*request), nullptr, 0, &response, sizeof(response));
+    return response.result != 0;
+}
